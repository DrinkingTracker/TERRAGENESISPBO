<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TERRAGENESIS.Pages.DonasiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TERRAGENESIS.Controls"
    Background="White">

    <Page.Resources>
        <FontFamily x:Key="FontBlack">Segoe UI Black</FontFamily>
        <FontFamily x:Key="FontIsi">Segoe UI</FontFamily>

        <Style x:Key="JudulBagian" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBlack}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="#0B4D1A"/>
        </Style>
        <Style x:Key="LabelForm" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontIsi}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="IsianForm" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource FontIsi}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D5DBD7"/>
            <Setter Property="Background" Value="White"/>
            <!-- Tanpa saran kata / koreksi ejaan saat mengetik -->
            <Setter Property="IsSpellCheckEnabled" Value="False"/>
            <Setter Property="IsTextPredictionEnabled" Value="False"/>
        </Style>

        <!-- Isian tetap putih dengan teks hitam saat disorot atau diklik -->
        <SolidColorBrush x:Key="TextControlBackground" Color="White"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White"/>
        <SolidColorBrush x:Key="TextControlForeground" Color="Black"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Black"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="Black"/>
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D5DBD7"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B8C4BC"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2E7D32"/>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

        <!-- Tombol bulat -/+ pada counter jumlah pohon -->
        <Style x:Key="TombolCounter" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E7E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <!-- Kanvas 1440 x 1024 (Figma: Donasi 5:1090) -->
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Kanvas" Width="1440" Height="1024" Background="White">

            <controls:NavbarControl Canvas.Left="0" Canvas.Top="0"
                                    ActivePage="Donasi"
                                    NavigateRequested="Navbar_NavigateRequested"/>

            <!-- ============ KARTU KIRI: petak dan form donatur ============ -->
            <Border x:Name="KartuKiri" Canvas.Left="48" Canvas.Top="141" Width="653" Height="843"
                    CornerRadius="30" Background="White" BorderBrush="#E6E9E7" BorderThickness="1">
                <Canvas>
                    <Border Canvas.Left="0" Canvas.Top="0" Width="651" Height="369" CornerRadius="29,29,0,0">
                        <Border.Background>
                            <ImageBrush x:Name="BrushFotoLahan" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <!-- Label petak di atas foto -->
                    <Border Canvas.Left="9" Canvas.Top="302" Padding="14,8,24,10" CornerRadius="16"
                            Background="#990E2A16" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tanam pohon baru" FontFamily="{StaticResource FontBlack}"
                                       FontSize="19" Foreground="#3FC24A"/>
                            <TextBlock x:Name="TxtLabelPetak" FontFamily="{StaticResource FontIsi}"
                                       FontSize="16" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Canvas.Left="21" Canvas.Top="394" Text="Jumlah Pohon" Style="{StaticResource JudulBagian}"/>
                    <TextBlock Canvas.Left="326" Canvas.Top="394" Text="Total Donasi" Style="{StaticResource JudulBagian}"/>

                    <!-- Counter jumlah pohon -->
                    <Border Canvas.Left="21" Canvas.Top="449" Width="246" Height="56"
                            CornerRadius="28" Background="#EEF1F0"/>
                    <Button x:Name="BtnKurang" Canvas.Left="21" Canvas.Top="449"
                            Style="{StaticResource TombolCounter}" Click="BtnKurang_Click"
                            AutomationProperties.Name="Kurangi jumlah pohon">
                        <FontIcon Glyph="&#xE738;" FontSize="20" Foreground="#2E7D32"/>
                    </Button>
                    <TextBlock x:Name="TxtJumlah" Canvas.Left="77" Canvas.Top="461" Width="134"
                               TextAlignment="Center" Text="1"
                               FontFamily="{StaticResource FontBlack}" FontSize="24" Foreground="Black"/>
                    <Button x:Name="BtnTambah" Canvas.Left="211" Canvas.Top="449"
                            Style="{StaticResource TombolCounter}" Click="BtnTambah_Click"
                            AutomationProperties.Name="Tambah jumlah pohon">
                        <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="#2E7D32"/>
                    </Button>

                    <!-- Total donasi otomatis (jumlah x harga) -->
                    <Border Canvas.Left="326" Canvas.Top="449" Width="246" Height="56"
                            CornerRadius="28" Background="White" BorderBrush="#E3E7E4" BorderThickness="1">
                        <TextBlock x:Name="TxtTotal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Rp 0" FontFamily="{StaticResource FontBlack}" FontSize="26"
                                   Foreground="Black"/>
                    </Border>

                    <TextBlock Canvas.Left="21" Canvas.Top="534" Text="Nama Donatur" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="NamaTextBox" Canvas.Left="21" Canvas.Top="557" Width="576" Height="53"
                             Style="{StaticResource IsianForm}" MaxLength="100"
                             IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>

                    <TextBlock Canvas.Left="21" Canvas.Top="628" Text="Pesan / Harapan Donatur" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="PesanTextBox" Canvas.Left="21" Canvas.Top="651" Width="576" Height="104"
                             Style="{StaticResource IsianForm}" MaxLength="500"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>

                    <Border Canvas.Left="21" Canvas.Top="779" Width="576" Height="42"
                            CornerRadius="8" Background="#E8F6E5" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/Donasi/aleritcon.png" Width="22" Height="22"/>
                            <TextBlock x:Name="TxtHargaPohon" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontIsi}" FontSize="16" Foreground="#6B7F72"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Border>

            <!-- ============ KARTU KANAN: metode dan bukti pembayaran ============ -->
            <Border Canvas.Left="738" Canvas.Top="141" Width="653" Height="843"
                    CornerRadius="30" Background="White" BorderBrush="#E6E9E7" BorderThickness="1">
                <Canvas>
                    <TextBlock Canvas.Left="37" Canvas.Top="30" Text="Metode Pembayaran"
                               FontFamily="{StaticResource FontBlack}" FontSize="36" Foreground="#0B4D1A"/>

                    <!-- Pilihan metode (diisi dari database lewat DonasiService) -->
                    <StackPanel x:Name="DaftarMetode" Canvas.Left="35" Canvas.Top="103" Width="587" Spacing="33"/>

                    <!-- Instruksi pembayaran + upload bukti -->
                    <Border Canvas.Left="35" Canvas.Top="449" Width="587" Height="255"
                            CornerRadius="20" Background="White" BorderBrush="#E3E7E4" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="118"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#E8F6E5" CornerRadius="19,19,0,0" Padding="18,14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Instruksi Pembayaran" FontFamily="{StaticResource FontIsi}"
                                               FontSize="18" FontWeight="Bold" Foreground="#0B4D1A"/>
                                    <TextBlock x:Name="TxtInstruksi" FontFamily="{StaticResource FontIsi}"
                                               FontSize="17" LineHeight="24" Foreground="#555555" TextWrapping="Wrap"
                                               Text="Pilih metode pembayaran di atas."/>
                                </StackPanel>
                            </Border>

                            <!-- Area upload: klik untuk memilih file -->
                            <Button x:Name="BtnUpload" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="0,0,19,19"
                                    Click="BtnUpload_Click" AutomationProperties.Name="Upload bukti pembayaran">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Image x:Name="GambarBukti" Source="ms-appx:///Assets/Donasi/uploadicon.png"
                                           Height="52" MaxWidth="200" Stretch="Uniform"/>
                                    <TextBlock x:Name="TxtUpload" TextAlignment="Center"
                                               FontFamily="{StaticResource FontIsi}" FontSize="16" Foreground="#6B6B6B">
                                        <Run Text="Upload bukti transfer"/><LineBreak/><Run Text="(JPG,PNG, maksimal 5MB)"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnKonfirmasi" Canvas.Left="160" Canvas.Top="750"
                            Width="334" Height="50" CornerRadius="16" Padding="0"
                            HorizontalContentAlignment="Center" Click="BtnKonfirmasi_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#25442B"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2F5636"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1B3320"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#9DB0A2"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                        </Button.Resources>
                        <TextBlock Text="Konfirmasi Donasi" FontFamily="{StaticResource FontIsi}"
                                   FontSize="16" FontWeight="Bold"/>
                    </Button>
                </Canvas>
            </Border>
        </Canvas>
    </Viewbox>
</Page>
