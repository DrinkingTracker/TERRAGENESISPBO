<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TERRAGENESIS.Pages.PetaWilayahPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TERRAGENESIS.Controls"
    Background="White">

    <Page.Resources>
        <!-- Font sementara, sama seperti BerandaPage -->
        <FontFamily x:Key="FontBlack">Segoe UI Black</FontFamily>
        <FontFamily x:Key="FontIsi">Segoe UI</FontFamily>

        <!-- Label wilayah: pil hijau gelap (Figma: Peta wilayah 4:80) -->
        <Style x:Key="LabelWilayah" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#12321F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource FontIsi}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#317D3E"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#25442B"/>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
    </Page.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="1440" Height="1024" Background="White">

            <controls:NavbarControl Canvas.Left="0" Canvas.Top="0"
                                    ActivePage="Lahan"
                                    NavigateRequested="Navbar_NavigateRequested"/>

            <TextBlock Canvas.Left="0" Canvas.Top="170" Width="1440" TextAlignment="Center"
                       Text="Pilih wilayah penanaman"
                       FontFamily="{StaticResource FontBlack}" FontSize="46" Foreground="#12352A"/>
            <TextBlock x:Name="TxtSubjudul" Canvas.Left="0" Canvas.Top="234" Width="1440" TextAlignment="Center"
                       Text="Klik salah satu wilayah hijau untuk melihat petak lahan yang tersedia."
                       FontFamily="{StaticResource FontIsi}" FontSize="18" Foreground="#5F7A6D"/>

            <!-- Peta Indonesia per provinsi (Simplemaps, 1000 x 368) diskalakan ke lebar 1440 -->
            <Image Source="ms-appx:///Assets/PetaWilayah/peta.svg"
                   Canvas.Left="0" Canvas.Top="305" Width="1440" Height="530" Stretch="Fill"/>

            <!-- Area klik per wilayah (transparan, di atas pulau masing-masing) -->
            <Rectangle Canvas.Left="0" Canvas.Top="320" Width="340" Height="350" Fill="Transparent"
                       Tag="Sumatra" Tapped="Area_Tapped"/>
            <Rectangle Canvas.Left="430" Canvas.Top="365" Width="320" Height="255" Fill="Transparent"
                       Tag="Kalimantan" Tapped="Area_Tapped"/>
            <Rectangle Canvas.Left="745" Canvas.Top="455" Width="205" Height="215" Fill="Transparent"
                       Tag="Sulawesi" Tapped="Area_Tapped"/>
            <Rectangle Canvas.Left="1100" Canvas.Top="500" Width="340" Height="270" Fill="Transparent"
                       Tag="Papua" Tapped="Area_Tapped"/>
            <Rectangle Canvas.Left="440" Canvas.Top="680" Width="180" Height="90" Fill="Transparent"
                       Tag="Jawa Timur" Tapped="Area_Tapped"/>

            <!-- Label wilayah (posisi mengikuti Figma) -->
            <Button Canvas.Left="170" Canvas.Top="478" Content="Sumatra" Tag="Sumatra"
                    Style="{StaticResource LabelWilayah}" Click="Label_Click"/>
            <Button Canvas.Left="541" Canvas.Top="502" Content="Kalimantan" Tag="Kalimantan"
                    Style="{StaticResource LabelWilayah}" Click="Label_Click"/>
            <Button Canvas.Left="759" Canvas.Top="568" Content="Sulawesi" Tag="Sulawesi"
                    Style="{StaticResource LabelWilayah}" Click="Label_Click"/>
            <Button Canvas.Left="1346" Canvas.Top="613" Content="Papua" Tag="Papua"
                    Style="{StaticResource LabelWilayah}" Click="Label_Click"/>
            <Button Canvas.Left="466" Canvas.Top="710" Content="Jawa Timur" Tag="Jawa Timur"
                    Style="{StaticResource LabelWilayah}" Click="Label_Click"/>
        </Canvas>
    </Viewbox>
</Page>
