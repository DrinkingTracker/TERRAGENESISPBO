<Page
    x:Class="TERRAGENESIS.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#1B3A22">

    <Page.Resources>
        <!-- FONT: sementara pakai font bawaan Windows.
             Figma memakai Metropolis Black, Gotham Black/Bold, dan Plus Jakarta Sans.
             Kalau nanti memasang file font, cukup ganti tiga baris ini. -->
        <FontFamily x:Key="FontBlack">Segoe UI Black</FontFamily>
        <FontFamily x:Key="FontBold">Segoe UI</FontFamily>
        <FontFamily x:Key="FontIsi">Segoe UI</FontFamily>

        <!-- Kotak input: transparan dan tanpa garis (garis hijau ada di Border pembungkusnya) -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <SolidColorBrush x:Key="TextControlForeground" Color="Black" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Black" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="Black" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8DA196" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8DA196" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8DA196" />

        <!-- Checkbox "Ingat Saya": kotak hitam, hijau gelap saat dicentang -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="Black" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="Black" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="Black" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#25442B" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#25442B" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#25442B" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#25442B" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#25442B" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#25442B" />
        <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="Black" />
        <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="Black" />
        <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="Black" />
        <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="Black" />
        <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="Black" />
        <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="Black" />

        <!-- "Lupa Password?" berwarna hitam -->
        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="Black" />
        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#25442B" />
        <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#25442B" />
    </Page.Resources>

    <Grid>
        <!-- Latar foto memenuhi seluruh jendela -->
        <Image Source="ms-appx:///Assets/login/LoginBackground.jpeg" Stretch="UniformToFill" />

        <!-- Seluruh isi dirancang di kanvas 1440 x 1024 (ukuran frame Figma),
             lalu Viewbox menskalakannya mengikuti ukuran jendela -->
        <Viewbox Stretch="Uniform">
            <Canvas Width="1440" Height="1024">

                <!-- ============ SISI KIRI: branding ============ -->
                <Image Source="ms-appx:///Assets/login/logo.png"
                       Width="136" Height="136" Canvas.Left="29" Canvas.Top="316" />

                <TextBlock Text="TERRAGENESIS" Canvas.Left="165" Canvas.Top="319"
                           FontFamily="{StaticResource FontBlack}" FontSize="68"
                           Foreground="#317D3E" />

                <TextBlock Text="Bersama menanam, menjaga bumi." Canvas.Left="179" Canvas.Top="399"
                           FontFamily="{StaticResource FontBlack}" FontSize="24"
                           Foreground="#317D3E" />

                <TextBlock Canvas.Left="46" Canvas.Top="471"
                           FontFamily="{StaticResource FontBlack}" FontSize="56" FontStyle="Italic">
                    <Run Text="Hijaukan Bumi," Foreground="#0B3620" /><LineBreak />
                    <Run Text="Mulai dari " Foreground="#0B3620" /><Run Text="Sekarang" Foreground="#317D3E" />
                </TextBlock>

                <TextBlock Canvas.Left="56" Canvas.Top="611" Width="502" TextWrapping="Wrap"
                           FontFamily="{StaticResource FontBold}" FontSize="20" FontWeight="Bold"
                           LineHeight="26" Foreground="White"
                           Text="Bergabunglah dalam gerakan penghijauan melalui donasi pohon di lahan yang membutuhkan." />

                <!-- ============ SISI KANAN: kartu login ============ -->
                <Border Canvas.Left="782" Canvas.Top="135" Width="585" Height="714"
                        CornerRadius="37" Background="White">
                    <Canvas>
                        <!-- watermark globe samar di tengah kartu (pakai logo, file watermark tidak ada) -->
                        <Image Source="ms-appx:///Assets/login/logo.png"
                               Width="534" Height="534" Canvas.Left="25" Canvas.Top="101" Opacity="0.1" />

                        <!-- daun hias: kiri atas dan kanan bawah -->
                        <Image Source="ms-appx:///Assets/login/leaf.png"
                               Width="267" Height="207" Canvas.Left="0" Canvas.Top="0" />
                        <Image Source="ms-appx:///Assets/login/leaf.png"
                               Width="267" Height="207" Canvas.Left="318" Canvas.Top="507"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <RotateTransform Angle="180" />
                            </Image.RenderTransform>
                        </Image>

                        <TextBlock Text="Masuk ke Akun Anda" Width="585" Canvas.Left="0" Canvas.Top="119"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource FontBlack}" FontSize="36"
                                   Foreground="#122F20" />

                        <!-- Kolom email -->
                        <Border Canvas.Left="34" Canvas.Top="213" Width="516" Height="57"
                                CornerRadius="14" Background="White"
                                BorderBrush="#6F9C76" BorderThickness="1" />
                        <Image Source="ms-appx:///Assets/login/user.png"
                               Width="35" Height="35" Canvas.Left="58" Canvas.Top="224" Opacity="0.7" />
                        <TextBox x:Name="EmailTextBox" Canvas.Left="127" Canvas.Top="229"
                                 Width="390" Height="26" MinHeight="0" Padding="0"
                                 FontFamily="{StaticResource FontIsi}" FontSize="16" FontWeight="Medium"
                                 PlaceholderText="Email atau Username" />

                        <!-- Kolom password -->
                        <Border Canvas.Left="34" Canvas.Top="311" Width="516" Height="57"
                                CornerRadius="14" Background="White"
                                BorderBrush="#6F9C76" BorderThickness="1" />
                        <Image Source="ms-appx:///Assets/login/padlock.png"
                               Width="35" Height="35" Canvas.Left="58" Canvas.Top="322" Opacity="0.7" />
                        <PasswordBox x:Name="PasswordInput" Canvas.Left="127" Canvas.Top="327"
                                     Width="350" Height="26" MinHeight="0" Padding="0"
                                     FontFamily="{StaticResource FontIsi}" FontSize="16" FontWeight="Medium"
                                     PlaceholderText="Password" PasswordRevealMode="Hidden" />
                        <Button x:Name="TogglePasswordButton" Canvas.Left="493" Canvas.Top="322"
                                Width="35" Height="35" Padding="0" Background="Transparent"
                                BorderThickness="0" Click="TogglePasswordButton_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </Button.Resources>
                            <Image x:Name="EyeImage" Source="ms-appx:///Assets/login/eye-off.png"
                                   Width="35" Height="35" Opacity="0.7" />
                        </Button>

                        <!-- Ingat saya / Lupa password: di bawah kolom password, sesuai desain -->
                        <CheckBox x:Name="IngatSayaCheckBox" Content="Ingat Saya"
                                  Canvas.Left="40" Canvas.Top="385" MinWidth="0" Padding="17,0,0,0"
                                  FontFamily="{StaticResource FontBold}" FontSize="20" FontWeight="Bold" />
                        <HyperlinkButton x:Name="LupaPasswordButton" Content="Lupa Password?"
                                         Canvas.Left="400" Canvas.Top="390" Padding="0"
                                         FontFamily="{StaticResource FontBold}" FontSize="20" FontWeight="Bold"
                                         Click="LupaPasswordButton_Click" />

                        <!-- Tombol Masuk -->
                        <Button x:Name="MasukButton" Canvas.Left="34" Canvas.Top="467"
                                Width="516" Height="54" CornerRadius="16" Padding="0"
                                Background="#25442B" Foreground="White" BorderThickness="0"
                                HorizontalContentAlignment="Center"
                                Click="MasukButton_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2F5636" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1B3320" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/login/login-arrow.png" Width="30" Height="30" />
                                <TextBlock Text="Masuk" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontBlack}" FontSize="20" />
                            </StackPanel>
                        </Button>

                        <!-- Daftar -->
                        <TextBlock Canvas.Left="0" Canvas.Top="529" Width="585" TextAlignment="Center"
                                   FontFamily="{StaticResource FontBold}" FontSize="16" FontWeight="Bold"
                                   Foreground="Black">
                            <Run Text="Belum Punya Akun? " /><Hyperlink Foreground="#3AAD30" UnderlineStyle="None"
                                        Click="DaftarLink_Click">Daftar Sekarang</Hyperlink>
                        </TextBlock>

                        <!-- Pesan status (tambahan, tidak ada di Figma) -->
                        <TextBlock x:Name="PesanTextBlock" Canvas.Left="34" Canvas.Top="575" Width="516"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="{StaticResource FontIsi}" FontSize="14"
                                   Foreground="#B3261E" />
                    </Canvas>
                </Border>
            </Canvas>
        </Viewbox>
    </Grid>
</Page>