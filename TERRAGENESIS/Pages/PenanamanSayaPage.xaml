<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TERRAGENESIS.Pages.PenanamanSayaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TERRAGENESIS.Controls"
    Background="White">

    <Page.Resources>
        <FontFamily x:Key="FontBlack">Segoe UI Black</FontFamily>
        <FontFamily x:Key="FontIsi">Segoe UI</FontFamily>

        <Style x:Key="JudulTahap" TargetType="TextBlock">
            <Setter Property="Width" Value="220"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBlack}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="TanggalTahap" TargetType="TextBlock">
            <Setter Property="Width" Value="220"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource FontIsi}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#6B6B6B"/>
        </Style>
    </Page.Resources>

    <!-- Kanvas 1440 x 1024 (Figma: "Pesanan saya" 44:550, judul di layar: Penanaman Saya) -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="1440" Height="1024" Background="White">

            <controls:SidebarControl Canvas.Left="0" Canvas.Top="0" ActiveMenu="Penanaman Saya"
                                     MenuDipilih="Sidebar_MenuDipilih"/>

            <TextBlock Canvas.Left="467" Canvas.Top="62" Text="Penanaman Saya"
                       FontFamily="{StaticResource FontBlack}" FontSize="64" Foreground="Black"/>
            <!-- Petak yang sedang ditampilkan (tambahan kecil; Figma hanya menampilkan satu penanaman) -->
            <TextBlock x:Name="TxtPetak" Canvas.Left="470" Canvas.Top="150"
                       FontFamily="{StaticResource FontIsi}" FontSize="16" Foreground="#5F7A6D"/>

            <!-- Timeline 3 tahap: garis dulu supaya berada di belakang lingkaran -->
            <Rectangle x:Name="Garis1" Canvas.Left="560" Canvas.Top="268" Width="326" Height="4" Fill="#C9E8CC"/>
            <Rectangle x:Name="Garis2" Canvas.Left="979" Canvas.Top="268" Width="298" Height="4" Fill="#C9E8CC"/>

            <Grid x:Name="Tahap1" Canvas.Left="465" Canvas.Top="222" Width="96" Height="96"/>
            <Grid x:Name="Tahap2" Canvas.Left="884" Canvas.Top="222" Width="96" Height="96"/>
            <Grid x:Name="Tahap3" Canvas.Left="1276" Canvas.Top="222" Width="96" Height="96"/>

            <TextBlock Canvas.Left="403" Canvas.Top="332" Style="{StaticResource JudulTahap}">
                <Run Text="Donasi"/><LineBreak/><Run Text="Terverifikasi"/>
            </TextBlock>
            <TextBlock x:Name="TxtTanggal1" Canvas.Left="403" Canvas.Top="384" Style="{StaticResource TanggalTahap}"/>

            <TextBlock Canvas.Left="822" Canvas.Top="332" Style="{StaticResource JudulTahap}">
                <Run Text="Penanaman"/><LineBreak/><Run Text="Dilakukan"/>
            </TextBlock>
            <TextBlock x:Name="TxtTanggal2" Canvas.Left="822" Canvas.Top="384" Style="{StaticResource TanggalTahap}"/>

            <TextBlock Canvas.Left="1214" Canvas.Top="332" Style="{StaticResource JudulTahap}">
                <Run Text="Selesai"/><LineBreak/><Run Text="Penanaman"/>
            </TextBlock>
            <TextBlock x:Name="TxtTanggal3" Canvas.Left="1214" Canvas.Top="384" Style="{StaticResource TanggalTahap}"/>

            <TextBlock Canvas.Left="467" Canvas.Top="497" Text="Dokumentasi Lahan"
                       FontFamily="{StaticResource FontBlack}" FontSize="64" Foreground="Black"/>

            <!-- Foto dokumentasi dari admin -->
            <Border Canvas.Left="471" Canvas.Top="640" Width="914" Height="252"
                    CornerRadius="24" Background="White" BorderBrush="#E3E7E4" BorderThickness="1">
                <Grid>
                    <StackPanel x:Name="KosongDokumentasi" Orientation="Horizontal" Spacing="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/user/uploadicon.png" Width="72" Height="52"/>
                        <TextBlock Text="Belum ada gambar yang di upload" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontIsi}" FontSize="20" FontWeight="Medium"
                                   Foreground="#8A8A8A"/>
                    </StackPanel>
                    <ScrollViewer x:Name="ScrollFoto" Visibility="Collapsed" Padding="24,0"
                                  HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DaftarFoto" Orientation="Horizontal" Spacing="16"
                                    VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Canvas.Left="471" Canvas.Top="935" Width="914" Height="42"
                    CornerRadius="8" Background="#E8F6E5" Padding="14,0">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/user/alerticon.png" Width="22" Height="22"/>
                    <TextBlock Text="Catatan : Timeline bisa berubah kapan saja" VerticalAlignment="Center"
                               FontFamily="{StaticResource FontIsi}" FontSize="16" Foreground="#6B7F72"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Viewbox>
</Page>
