<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TERRAGENESIS.Pages.DonasiSayaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TERRAGENESIS.Controls"
    Background="White">

    <Page.Resources>
        <FontFamily x:Key="FontBlack">Segoe UI Black</FontFamily>
        <FontFamily x:Key="FontIsi">Segoe UI</FontFamily>

        <Style x:Key="KepalaKolom" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontIsi}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Baris tabel bisa diklik untuk membuka Penanaman Saya -->
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F3F8F3"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E6F0E6"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="Black"/>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black"/>
    </Page.Resources>

    <!-- Kanvas 1440 x 1024 (Figma: Donasi Saya 44:263) -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="1440" Height="1024" Background="White">

            <controls:SidebarControl Canvas.Left="0" Canvas.Top="0" ActiveMenu="Donasi Saya"
                                     MenuDipilih="Sidebar_MenuDipilih"/>

            <TextBlock Canvas.Left="467" Canvas.Top="62" Text="Riwayat Donasi"
                       FontFamily="{StaticResource FontBlack}" FontSize="64" Foreground="Black"/>

            <!-- Tabel riwayat donasi -->
            <Border Canvas.Left="432" Canvas.Top="207" Width="989" MaxHeight="780"
                    CornerRadius="20" Background="White" BorderBrush="#D9DEDB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Background="#EFF3F6" CornerRadius="19,19,0,0" Padding="54,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="289"/>
                            <ColumnDefinition Width="242"/>
                            <ColumnDefinition Width="243"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tanggal" Style="{StaticResource KepalaKolom}"/>
                        <TextBlock Grid.Column="1" Text="Wilayah" Style="{StaticResource KepalaKolom}"/>
                        <TextBlock Grid.Column="2" Text="Nominal" Style="{StaticResource KepalaKolom}"/>
                        <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource KepalaKolom}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="720" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DaftarBaris"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Canvas>
    </Viewbox>
</Page>
