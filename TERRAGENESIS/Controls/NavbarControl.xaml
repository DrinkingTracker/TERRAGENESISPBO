<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TERRAGENESIS.Controls.NavbarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1440" Height="131">

    <UserControl.Resources>
        <!-- Font sementara. Ganti bila font Figma sudah dipasang:
             FontBlack -> Metropolis Black / Gotham Black
             FontIsi   -> Plus Jakarta Sans (pakai FontWeight ExtraBold / Medium di tiap teks) -->
        <FontFamily x:Key="FontBlack">Segoe UI Black</FontFamily>
        <FontFamily x:Key="FontIsi">Segoe UI</FontFamily>

        <!-- Tombol navigasi tampil seperti teks biasa; hanya berubah tipis saat disorot -->
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1A3A7232"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#333A7232"/>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="Black"/>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black"/>
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="Gray"/>
    </UserControl.Resources>

    <Canvas Background="White">

        <!-- Logo + nama aplikasi (Figma: Logo 1 2:3, teks 2:5) -->
        <Button Canvas.Left="30" Canvas.Top="32" Width="420" Height="80" Padding="0"
                Tag="Beranda" Click="Nav_Click"
                AutomationProperties.Name="TERRAGENESIS, ke Beranda">
            <Canvas Width="420" Height="80">
                <Image Source="ms-appx:///Assets/beranda/logo.png"
                       Width="80" Height="80" Stretch="Fill"/>
                <TextBlock Canvas.Left="80" Canvas.Top="20"
                           Text="TERRAGENESIS"
                           FontFamily="{StaticResource FontBlack}" FontSize="40"
                           Foreground="#317D3E"/>
            </Canvas>
        </Button>

        <!-- Menu (Figma: teks 26px, y=45). Lebar tombol = lebar teks di Figma,
             teks di tengah, supaya garis bawah tetap pas walau fontnya diganti. -->
        <Button Canvas.Left="629" Canvas.Top="45" Width="108" Height="33" Padding="0"
                Tag="Beranda" Click="Nav_Click">
            <TextBlock Text="Beranda" FontFamily="{StaticResource FontIsi}" FontSize="26" FontWeight="ExtraBold"/>
        </Button>
        <Button Canvas.Left="806" Canvas.Top="45" Width="76" Height="33" Padding="0"
                Tag="Lahan" Click="Nav_Click">
            <TextBlock Text="Lahan" FontFamily="{StaticResource FontIsi}" FontSize="26" FontWeight="ExtraBold"/>
        </Button>
        <Button Canvas.Left="951" Canvas.Top="45" Width="88" Height="33" Padding="0"
                Tag="Donasi" Click="Nav_Click">
            <TextBlock Text="Donasi" FontFamily="{StaticResource FontIsi}" FontSize="26" FontWeight="ExtraBold"/>
        </Button>
        <Button Canvas.Left="1108" Canvas.Top="45" Width="83" Height="33" Padding="0"
                Tag="Profile" Click="Nav_Click">
            <TextBlock Text="Profile" FontFamily="{StaticResource FontIsi}" FontSize="26" FontWeight="ExtraBold"/>
        </Button>

        <!-- Garis bawah menu aktif (Figma: lebar 101.5, tebal 3, y=81) -->
        <Rectangle x:Name="GarisAktif" Canvas.Left="632" Canvas.Top="79.5"
                   Width="101.5" Height="3" RadiusX="1.5" RadiusY="1.5"
                   Fill="#3A7232" Visibility="Collapsed"/>

        <!-- Foto profil (Figma: profile 1 3:10) -->
        <Button Canvas.Left="1330" Canvas.Top="31" Width="80" Height="80" Padding="0"
                CornerRadius="40" Tag="Profile" Click="Nav_Click"
                AutomationProperties.Name="Profile">
            <Image Source="ms-appx:///Assets/beranda/profile.png" Width="80" Height="80" Stretch="Fill"/>
        </Button>
    </Canvas>
</UserControl>