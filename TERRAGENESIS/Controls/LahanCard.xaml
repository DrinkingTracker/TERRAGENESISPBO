<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TERRAGENESIS.Controls.LahanCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="406" Height="221">

    <UserControl.Resources>
        <!-- Font sementara, sama seperti NavbarControl (Figma: Gotham Black) -->
        <FontFamily x:Key="FontBlack">Segoe UI Black</FontFamily>
    </UserControl.Resources>

    <!-- Kartu: 406 x 221, sudut 25 (Figma: Frame 1 4:51) -->
    <Border x:Name="Root" CornerRadius="25" Background="White" Tapped="Root_Tapped">
        <Canvas>
            <!-- Foto lahan 406 x 121, hanya sudut atas yang membulat -->
            <Border Canvas.Left="0" Canvas.Top="0" Width="406" Height="121"
                    CornerRadius="25,25,0,0">
                <Border.Background>
                    <ImageBrush x:Name="BrushGambar" Stretch="Fill"/>
                </Border.Background>
            </Border>

            <!-- Ikon pin: pakai ikon bawaan Windows (MapPin), jadi tidak perlu file pin.png -->
            <Image Source="ms-appx:///Assets/beranda/pin.png"
                       Canvas.Left="18" Canvas.Top="135" Width="32" Height="32" Stretch="Fill"/>
            
            <TextBlock x:Name="TxtJudul" Canvas.Left="50" Canvas.Top="135"
                       FontFamily="{StaticResource FontBlack}" FontSize="28"
                       Foreground="Black"/>

            <!-- Lencana slot (Figma: 139 x 28, warna #C9EFCF; dilebarkan karena teks minimal 16px) -->
            <Border Canvas.Left="18" Canvas.Top="177" Width="180" Height="28"
                    CornerRadius="14" Background="#C9EFCF">
                <TextBlock x:Name="TxtSlot"
                           FontFamily="{StaticResource FontBlack}" FontSize="16"
                           Foreground="#122F20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Canvas>
    </Border>
</UserControl>